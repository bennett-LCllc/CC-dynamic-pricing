# Database
DATABASE_URL="postgresql://user:password@localhost:5432/corpus_christi_ops"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CC Ops"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Internal APIs
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_PRICING_API_URL="http://localhost:8000"

# External APIs (fill in when you have them)
AIRBNB_API_KEY=""
VRBO_API_KEY=""
TWILIO_ACCOUNT_SSID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
STRIPE_SECRET_KEY=""

# Upstash Redis (for caching/queues)
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# Auth (REQUIRED — api-node exits at startup if JWT_SECRET is missing)
# Generate a strong secret with:  openssl rand -base64 48
JWT_SECRET=""
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Bootstrap admin (optional — seed creates this account so you can log in)
SEED_ADMIN_EMAIL="admin@corpus-christi-ops.com"
SEED_ADMIN_PASSWORD="ChangeMe!Admin123"

# ===========================================
# OBSERVABILITY
# ===========================================

# Logging
LOG_LEVEL=info
NEXT_PUBLIC_LOG_LEVEL=info

# Sentry (Error Tracking & Performance)
# Get DSN from https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Prometheus/Grafana (for docker-compose local dev)
# These are used by the docker-compose services
PROMETHEUS_URL="http://localhost:9090"
GRAFANA_URL="http://localhost:3001"
LOKI_URL="http://localhost:3100"
TEMPO_URL="http://localhost:3200"
ALERTMANAGER_URL="http://localhost:9093"

# Grafana credentials (for local dev)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin