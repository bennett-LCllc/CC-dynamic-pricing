    "db:studio": "turbo run db:studio",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
