{
  "name": "corpus-christi-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Corpus Christi STR Portfolio Operations Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
