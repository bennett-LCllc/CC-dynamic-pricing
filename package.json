{
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/db",
    "packages/shared",
    "apps/api-node",
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "generate:openapi": "ts-node scripts/generate-openapi.ts",
    "test": "turbo run test && yarn test:api",
    "test:api": "cd apps/api && python -m pytest tests -q",
    "lint": "npm run lint -w @cc-ops/db -w @cc-ops/shared -w @cc-ops/api-node -w @cc-ops/web",
    "type-check": "npm run typecheck -w @cc-ops/db -w @cc-ops/shared -w @cc-ops/api-node -w @cc-ops/web",
    "build": "npm run db:generate -w @cc-ops/db && npm run build -w @cc-ops/db -w @cc-ops/api-node -w @cc-ops/web"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "glob": "^13.0.6",
    "js-yaml": "^5.2.3",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true
  },
  "dependencies": {
    "@sentry/nextjs": "^10.72.0"
  }
}
